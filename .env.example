# ─────────────────────────────────────────
# Supabase (requeridas en producción)
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # solo en servidor, nunca exponer al cliente

# ─────────────────────────────────────────
# API Football (RapidAPI)
# ─────────────────────────────────────────
API_FOOTBALL_KEY=your-rapidapi-key
API_FOOTBALL_HOST=v3.football.api-sports.io

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app   # URL de producción (afecta links de invitación)

# ─────────────────────────────────────────
# Cron / Sync (protección del endpoint /api/sync)
# ─────────────────────────────────────────
CRON_SECRET=2uUZGXBPnrJqF+h5tVX46ynHsazB1pqhR3mcpnJxrUA=   # openssl rand -hex 32

# ─────────────────────────────────────────
# Emails — Resend (opcional, para magic link + notificaciones futuras)
# ─────────────────────────────────────────
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=noreply@golazo.app

# ─────────────────────────────────────────
# Solo para scripts locales / Mac Mini (NO necesarias en Vercel)
# ─────────────────────────────────────────
# SUPABASE_PROJECT_ID=your-project-id
# SUPABASE_DB_PASSWORD=your-db-password
